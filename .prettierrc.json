{
  "$schema": "https://json.schemastore.org/prettierrc",
  "printWidth": 100,
  "proseWrap": "preserve",
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": [
        "*.md",
        "*.markdown"
      ],
      "options": {
        "proseWrap": "preserve",
        "tabWidth": 2,
        "embeddedLanguageFormatting": "off"
      }
    }
  ]
}
